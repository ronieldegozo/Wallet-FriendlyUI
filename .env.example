# Wallet Friendly — frontend environment variables
#
# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# Each Netlify site (production AND staging) overrides these values
# in its dashboard under "Site settings → Environment variables".

# Backend API base URL.
# Leave EMPTY in production — the Netlify _redirects file proxies
# /rest/* to the backend instead, which keeps everything same-origin
# and avoids CORS preflight requests in the browser.
# Override locally if you want to call a remote backend without the
# Vite dev proxy:
#   VITE_API_URL=https://wallet-friendly-api-staging.onrender.com
VITE_API_URL=

# Identifies the deployment environment. Drives the "STAGING" banner
# in src/components/StagingBanner. Allowed values:
#   - production  → no banner (default for live site)
#   - staging     → yellow STAGING banner
#   - development → blue DEVELOPMENT banner (use locally)
#
# In Netlify, this is set automatically by netlify.toml based on the
# branch being deployed.
VITE_ENV=development
